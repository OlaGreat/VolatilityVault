# ── Deployer ──────────────────────────────────────────────────────────────────
PRIVATE_KEY=

# ── RPC URLs ──────────────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=
REACTIVE_RPC_URL=

# ── Etherscan verification ────────────────────────────────────────────────────
ETHERSCAN_API_KEY=

# ── Uniswap V4 deployed addresses (verified from broadcast files) ─────────────
# Ethereum Sepolia (chain 11155111)
POOL_MANAGER=0xe03A1074c86CFEdd5C142C4F04F1a1536E203543

# ── Pool tokens (set to your test tokens) ────────────────────────────────────
# TOKEN0 must be < TOKEN1 by address (sorted)
TOKEN0=
TOKEN1=

# ── Deploy parameters ─────────────────────────────────────────────────────────
TICK_SPACING=60
SQRT_PRICE=79228162514264337593543950336
# Minimum swap size to flag as toxic (default: 1000 tokens with 18 decimals)
TOXIC_THRESHOLD=1000000000000000000000

# ── Fee token for YieldBuffer (e.g. USDC on Sepolia) ─────────────────────────
FEE_TOKEN=

# ── Set after DeployAll.s.sol ─────────────────────────────────────────────────
VRS_ORACLE=
HOOK_ADDRESS=
YIELD_BUFFER=
LP_NFT=
MOCK_YIELD_ROUTER=

# ── Set after pool initialization ─────────────────────────────────────────────
SWAP_ROUTER=0x9b6b46e2c869aa39918db7f52f5557fe577b6eee

# ── Set after VolatilityRSC deployment on Reactive Network ───────────────────
RSC_CALLBACK_ADDRESS=
